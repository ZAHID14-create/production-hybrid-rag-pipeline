# ==============================================================================
# Production Hybrid RAG Pipeline - Environment Configuration Template
# ==============================================================================
# Copy this file to 'backend/.env' and replace placeholders with your actual keys.
# NEVER commit 'backend/.env' or any credentials to Git!

# ------------------------------------------------------------------------------
# Google Gemini API Configuration
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_SECONDS=60.0
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_DELAY=1.0
GEMINI_RETRY_MAX_DELAY=4.0

# ------------------------------------------------------------------------------
# Backend Server & CORS Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Document Ingestion & Chunking Settings
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=1024
CHUNK_SIZE=500
CHUNK_OVERLAP=75
TOKENIZER_ENCODING=cl100k_base

# ------------------------------------------------------------------------------
# Storage & Local Indices Paths
# ------------------------------------------------------------------------------
DOCUMENTS_DIRECTORY=../documents
PROCESSED_DATA_DIRECTORY=../data/processed_documents
CHROMA_PERSIST_DIRECTORY=../data/chroma_db
BM25_INDEX_DIRECTORY=../data/bm25_index

# ------------------------------------------------------------------------------
# Retrieval & Cross-Encoder Reranker Settings
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RRF_K=60
RERANKER_MAX_LENGTH=384
RERANKER_INT8_QUANTIZATION=True
RERANKER_CANDIDATE_POOL=10
